# jenkins-mcp environment configuration.
# Copy to .env and fill in your values:  cp .env.example .env
#
# Unlike an AWS-style credential chain, Jenkins has no ambient credential
# discovery: the server URL and API token must be supplied explicitly.

# Base URL of the Jenkins controller. Required.
JENKINS_URL=https://ci.example.com

# Username paired with JENKINS_TOKEN for HTTP Basic auth. Required.
JENKINS_USER=

# Jenkins API token (Jenkins user -> Configure -> API Token -> Add new Token). Required.
JENKINS_TOKEN=

# --- Server behavior ---
# Comma-separated toolset names to enable (jobs,builds,queue,nodes,views,plugins), or "all" (default).
JENKINS_TOOLSETS=all

# "true" suppresses all mutating tools (jenkins_trigger_build, jenkins_stop_build,
# jenkins_cancel_queue_item).
JENKINS_READONLY=false
